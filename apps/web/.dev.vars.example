OPENROUTER_API_KEY=sk-or-...
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
# Optional: bearer token for a self-hosted judge endpoint (OpenRouter judges reuse OPENROUTER_API_KEY)
JUDGE_API_KEY=
# Local only: long-lived access tokens for manual testing without the plugin
ACCESS_TOKEN_TTL_SEC=86400
# Optional: comma-separated self-hosted IdP origins (the mock at http://localhost:9400 is trusted in dev)
SSO_TRUSTED_ORIGINS=
