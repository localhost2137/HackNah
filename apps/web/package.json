{
  "name": "@acl/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsr generate && tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply acl --local",
    "db:seed": "node scripts/seed.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply acl --remote",
    "cf-typegen": "wrangler types --strict-vars=false"
  },
  "dependencies": {
    "@acl/db": "workspace:*",
    "@acl/shared": "workspace:*",
    "@acl/ui": "workspace:*",
    "@better-auth/sso": "1.7.7",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.12.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "lucide-react": "^1.40.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.40",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
